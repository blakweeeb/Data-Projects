# ---------------------------------------------------------------------------
# Copia este archivo como .env  ->  cp .env.example .env
# ---------------------------------------------------------------------------

# Airflow: en Linux/macOS usa tu UID real (`id -u`); en Windows deja 50000
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# PostgreSQL de origen (OLTP de ventas)
PG_DATABASE=olist
PG_USER=olist
PG_PASSWORD=olist
PG_HOST_PORT=5432

# MinIO (S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
